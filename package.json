{
  "name": "helm-plugin-software-production",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Helm plugin for tdt-software-production: Kanban tool, Ready tasks and Task pipeline widgets",
  "license": "Apache-2.0",
  "keywords": [
    "helm-plugin"
  ],
  "files": [
