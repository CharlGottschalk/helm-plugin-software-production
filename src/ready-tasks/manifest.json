{
  "contract": "helm.widget/1",
  "id": "ready-tasks",
  "name": "Ready tasks",
  "version": "0.1.0",
  "description": "Software-production tasks ready to pick up across linked projects, by priority.",
  "category": "Work",
  "icon": "check",
  "size": { "w": 2, "h": 5, "minW": 2, "minH": 3 },
  "settings": [
    { "id": "priorities", "type": "choice", "label": "Priorities", "multiple": true, "min": 1,
      "options": [{ "value": "high", "label": "High" }, { "value": "medium", "label": "Medium" }, { "value": "low", "label": "Low" }], "default": ["high", "medium", "low"] },
    { "id": "limit", "type": "number", "label": "Show at most", "min": 1, "max": 50, "step": 1, "default": 10, "unit": "tasks" },
    { "id": "source", "type": "select", "label": "Task source", "default": "config",
      "help": "Each project's config.json task_system unless you override it here.", "options": [{ "value": "config", "label": "Project config (task_system)" }, { "value": "internal", "label": "Internal tasks" }, { "value": "jira", "label": "Jira (needs 023)" }, { "value": "linear", "label": "Linear (needs 023)" }, { "value": "github", "label": "GitHub (needs 023)" }] }
  ],
  "connections": [
    { "id": "tdt", "kind": "tdt-mcp", "operations": ["tdt_project_list"] },
    { "id": "sp", "kind": "files", "root": "project", "paths": [".tdt-project/tdt-software-production/**"], "operations": ["list", "read"] }
  ],
  "permissions": { "write": false },
  "entry": "index.html"
}
